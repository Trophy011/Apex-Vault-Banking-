rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny for unspecified paths
    match /{document=**} {
      allow read, write: if false;
    }

    // User profiles & bank accounts (stored securely, synced across all devices)
    match /users/{userId} {
      allow read, write: if true;
    }

    // Bank-wide transactions ledger
    match /transactions/{transactionId} {
      allow read, write: if true;
    }

    // Central $10 Billion USD vault reserve
    match /bank_reserves/{reserveId} {
      allow read, write: if true;
    }

    // Support live concierge & messaging
    match /support_chats/{chatId} {
      allow read, write: if true;

      match /messages/{messageId} {
        allow read, write: if true;
      }
    }

    match /support_messages/{messageId} {
      allow read, write: if true;
    }
  }
}


